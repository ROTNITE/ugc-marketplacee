NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://ugc:ugc@localhost:5432/ugc_marketplace
REDIS_URL=redis://localhost:6379

PAYMENT_PROVIDER=disabled
STORAGE_PROVIDER=local
JWT_SECRET=replace-with-local-development-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
PLATFORM_COMMISSION_PERCENT=10

# Observability
LOG_LEVEL=info

# Admin allowlist (comma-separated emails that are auto-promoted to admin role)
ADMIN_EMAILS=

# Referral economy
REFERRAL_SIGNUP_BONUS_CREDITS=50

# ============================================================
# Optional third-party integrations.
# Leave blank to use the safe dev stubs.
# Populate to activate the production adapter (no code changes
# needed - the registry picks it up at boot).
# ============================================================

# Email delivery (transactional). Activates SendgridEmailProvider.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ugc-marketplace.local

# Push notifications (legacy FCM HTTP). Activates FcmPushProvider.
FCM_SERVER_KEY=

# Media storage. Activates S3Storage.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Russian payments. Activates HttpYooKassaProvider alongside Stripe.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Social audience ingestion. Activate the official adapters.
YOUTUBE_API_KEY=
TIKTOK_ACCESS_TOKEN=
VK_ACCESS_TOKEN=

# OAuth sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
