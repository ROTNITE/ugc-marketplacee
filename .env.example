NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Database - Leave empty to run API in degraded mode without database
DATABASE_URL=
REDIS_URL=redis://localhost:6379

PAYMENT_PROVIDER=disabled
STORAGE_PROVIDER=local
JWT_SECRET=replace-with-local-development-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Stripe Configuration (optional in development)
# Leave empty to disable Stripe integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PLATFORM_COMMISSION_PERCENT=10

# Referral system
REFERRAL_SIGNUP_BONUS_CREDITS=50

# Admin emails (comma-separated)
ADMIN_EMAILS=
